# Supabase project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEVER expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Allowed web/app origins, comma-separated.
CORS_ORIGINS=http://localhost:5173
# Maximum image/frame payload size in bytes.
MAX_UPLOAD_BYTES=8000000
# Number of failed verification attempts allowed per IP/employee window.
RATE_LIMIT_ATTEMPTS=8
RATE_LIMIT_WINDOW_SECONDS=300
